										// Method- 0: 2-ND matching while planning for all robots;
										//         1: 2N-D matching while planning for only violating robots;
										//         2: 2V-D matching while planning for only violating robots (V=no. of violating robots)


IterationType:	2				// 1-FixedCount ; 2-AutoDetectConvergence
				100  10  5		// Max, Min Number of iterations; for AutoDetectConvergence, number of unchanged cycles before which to stop
MaxSuperIter:	3

RestartUponHomotopyJump:	TRUE
