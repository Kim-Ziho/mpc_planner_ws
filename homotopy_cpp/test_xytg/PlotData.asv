% ========================================================================
function OutTraj = TrajPostProcess_ComputeTheta(RawTraj)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);

OutTraj = RawTraj;

for robotNo = 1:RobotCount
    DXs = diff(RawTraj{robotNo}.x);
    DYs = diff(RawTraj{robotNo}.y);
    SegmentSlopeAng = atan2(DYs, DXs);
    LastSegmentSlopeAng = 0;
    for a = [1:length(SegmentSlopeAng), length(SegmentSlopeAng):-1:1]
        if (DXs(a)==0 && DYs(a)==0 && SegmentSlopeAng(a)==0)
            SegmentSlopeAng(a) = LastSegmentSlopeAng;
        else
            LastSegmentSlopeAng = SegmentSlopeAng(a);
        end
    end
    %OutTraj{robotNo}.th = [SegmentSlopeAng, SegmentSlopeAng(end)];
    th1s = [SegmentSlopeAng(1), SegmentSlopeAng];
    th2s = [SegmentSlopeAng, SegmentSlopeAng(end)];
    JumpIndices = abs(th1s-th2s) > pi;
    OutTraj{robotNo}.th = (th1s+th2s)/2 + JumpIndices.*(-pi*((th1s+th2s)>0) + pi*((th1s+th2s)<0));
    
end

% ------------------------------------------------------------------------

function OutTraj = TrajPostProcess_Interp(RawTraj, SubsampleInterval, method)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);

for robotNo = 1:RobotCount
    InSampleIndex = 1:length(RawTraj{robotNo}.t);
    OutSampleIndex = 1:SubsampleInterval:length(RawTraj{robotNo}.t);
    OutTraj{robotNo}.x = interp1(InSampleIndex, RawTraj{robotNo}.x, OutSampleIndex, method);
    OutTraj{robotNo}.y = interp1(InSampleIndex, RawTraj{robotNo}.y, OutSampleIndex, method);
    OutTraj{robotNo}.t = interp1(InSampleIndex, RawTraj{robotNo}.t, OutSampleIndex, method);
end

% ------------------------------------------------------------------------

function OutTraj = TrajPostProcess_ResampleUniformTime(RawTraj);
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);

ReSampledTimeInterval = inf;
MaxTime = 0;
for robotNo = 1:RobotCount
    ReSampledTimeInterval = min([ReSampledTimeInterval, diff(RawTraj{robotNo}.t)]);
    MaxTime = max([MaxTime, RawTraj{robotNo}.t(end)]);
end

ResampledTimeFinal = 0:ReSampledTimeInterval:MaxTime;
for robotNo = 1:RobotCount
    OutTraj{robotNo}.x = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.x, ResampledTimeFinal, 'cubic');
    OutTraj{robotNo}.y = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.y, ResampledTimeFinal, 'cubic');
    OutTraj{robotNo}.t = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.t, ResampledTimeFinal, 'cubic');
end

% ------------------------------------------------------------------------

function OutTraj = TrajPostProcess_LimitSpeed(RawTraj, maxSpeed)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);

for robotNo = 1:RobotCount
    DXs = diff(RawTraj{robotNo}.x);
    DYs = diff(RawTraj{robotNo}.y);
    Dists = sqrt(DXs.*DXs + DYs.*DYs); % dist over each segment
    TimeReqdForTravel = diff(RawTraj{robotNo}.t); % time required to tavarse each segment
    TravelSpeed = Dists ./ TimeReqdForTravel;
    %disp(sprintf('Travelspeeds: min=%d, max=%d', min(TravelSpeed), max(TravelSpeed)));
    SubSampleCounts = ceil(abs(TravelSpeed./maxSpeed));
    TheTimeSteps{robotNo} = RawTraj{robotNo}.t;
    disp(sprintf('Resampling for speeds for rob %d', robotNo));
    for a = 1:length(Dists)
        SubSampleInterval = TimeReqdForTravel(a)/max([SubSampleCounts(a),1]);
        newTimeSteps = (RawTraj{robotNo}.t(a)+SubSampleInterval):SubSampleInterval:(RawTraj{robotNo}.t(a+1)-SubSampleInterval);
        TheTimeSteps{robotNo}(end+1:end+length(newTimeSteps)) = newTimeSteps;
        %TheTimeSteps{robotNo} = [TheTimeSteps{robotNo}, RawTraj{robotNo}.t(a):(TimeReqdForTravel(a)/max([SubSampleCounts(a),1])):RawTraj{robotNo}.t(a+1)];
    end
end

AllSubsampledTimeSteps = [];
for robotNo = 1:RobotCount
    AllSubsampledTimeSteps = union(AllSubsampledTimeSteps, TheTimeSteps{robotNo});
end

for robotNo = 1:RobotCount
    OutTraj{robotNo}.x = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.x, AllSubsampledTimeSteps, 'cubic');
    OutTraj{robotNo}.y = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.y, AllSubsampledTimeSteps, 'cubic');
    %OutTraj{robotNo}.th = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.th, ResampledTimeFinal, 'cubic');
    OutTraj{robotNo}.t = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.t, AllSubsampledTimeSteps, 'cubic');
end

% ------------------------------------------------------------------------
function OutTraj = TrajPostProcess_LimitTurnrate(RawTraj, maxTurnRate, RobotIndices)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);
if nargin<3
    RobotIndices = 1:RobotCount;
end

for robotNo = RobotIndices
    Turns = diff(RawTraj{robotNo}.th); % turns over each segment
    Turns = Turns + 2*pi*(Turns<=-pi) - 2*pi*(Turns>pi);
    TimeReqdForTurns = diff(RawTraj{robotNo}.t); % time required to tavarse each segment
    TurnSpeeds = Turns ./ TimeReqdForTurns;
    SubSampleCounts = ceil(abs(TurnSpeeds./maxTurnRate));
    TheTimeSteps{robotNo} = RawTraj{robotNo}.t;
    disp(sprintf('Resampling for turnrates for rob %d', robotNo));
    for a = 1:length(Turns)
        SubSampleInterval = TimeReqdForTurns(a)/max([SubSampleCounts(a),1]);
        newTimeSteps = (RawTraj{robotNo}.t(a)+SubSampleInterval):SubSampleInterval:(RawTraj{robotNo}.t(a+1)-SubSampleInterval);
        TheTimeSteps{robotNo}(end+1:end+length(newTimeSteps)) = newTimeSteps;
        %TheTimeSteps{robotNo} = [TheTimeSteps{robotNo}, RawTraj{robotNo}.t(a):(TimeReqdForTurns(a)/max([SubSampleCounts(a),1])):RawTraj{robotNo}.t(a+1)];
    end
end

AllSubsampledTimeSteps = [];
for robotNo = RobotIndices
    AllSubsampledTimeSteps = union(AllSubsampledTimeSteps, TheTimeSteps{robotNo});
end

for robotNo = 1:RobotCount
    OutTraj{robotNo}.x = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.x, AllSubsampledTimeSteps, 'cubic');
    OutTraj{robotNo}.y = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.y, AllSubsampledTimeSteps, 'cubic');
    %OutTraj{robotNo}.th = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.th, ResampledTimeFinal, 'cubic');
    OutTraj{robotNo}.t = interp1(RawTraj{robotNo}.t, RawTraj{robotNo}.t, AllSubsampledTimeSteps, 'cubic');
end

% ------------------------------------------------------------------------

function OutTraj = TrajPostProcess_ObsAvoid(RawTraj, minDistObs)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
global minDistFromObs
minDistFromObs = minDistObs;
RobotCount = length(IterData{IterNo}.Robot);

for robotNo = 1:RobotCount
    ptCount = length(RawTraj{robotNo}.t);
    for a = 1:ptCount
        [OutTraj{robotNo}.x(a), OutTraj{robotNo}.y(a)] = ObsAvoidedPt(RawTraj{robotNo}.x(a), RawTraj{robotNo}.y(a));
    end
    OutTraj{robotNo}.t = RawTraj{robotNo}.t;
end


function [xa,ya] = ObsAvoidedPt(x,y)
global ObsCoords
global minDistFromObs
obsCenterOffset = minDistFromObs+0.5;

dXObs = x - ObsCoords(:,1);
dYObs = y - ObsCoords(:,2);
distObs = sqrt(dXObs.*dXObs + dYObs.*dYObs);
[minObsDist, closestObsIndx] = min(distObs);
minObsDistX = dXObs(closestObsIndx);
minObsDistY = dYObs(closestObsIndx);
minObsDistXabs = abs(minObsDistX);
minObsDistYabs = abs(minObsDistY);

if max([minObsDistXabs,minObsDistYabs]) > obsCenterOffset % moving parrel to a wall - far enough from wall
    xa = x;
    ya = y;
    return;
end

xo = ObsCoords(closestObsIndx,1);
yo = ObsCoords(closestObsIndx,2);
if (minObsDistXabs>minObsDistYabs) && (minObsDistYabs<=0.5) % moving parrel to a wall - close to wall
    xa = xo + obsCenterOffset*sign(minObsDistX);
    ya = y;
    return;
elseif (minObsDistYabs>minObsDistXabs) && (minObsDistXabs<=0.5)
    xa = x;
    ya = yo + obsCenterOffset*sign(minObsDistY);
    return;
end

xv = xo + 0.5*sign(minObsDistX);
yv = yo + 0.5*sign(minObsDistY);
minVertexDistX = x - xv;
minVertexDistY = y - yv;
minVertexDist = sqrt(minVertexDistX*minVertexDistX + minVertexDistY*minVertexDistY);
if minVertexDist > minDistFromObs % Taking a turn - safety distance satisfied
    xa = x;
    ya = y;
    return;
else
    if (minVertexDist>0)
        pushRatio = minDistFromObs/minVertexDist;
        xa = xv + (x-xv)*pushRatio;
        ya = yv + (y-yv)*pushRatio;
    else
        dXov = xv - xo;
        dYov = yv - yo;
        ovDist = sqrt(dXov*dXov + dYov*dYov);
        xa = xo + (xv-xo)*obsCenterOffset/ovDist;
        ya = yo + (yv-yo)*obsCenterOffset/ovDist;
    end
end

% ------------------------------------------------------------------------

function OutTraj = TrajPostProcess_RobAvoid(RawTraj, minDistRobCenter, RobIndices, symmetry)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);
ptCount = length(RawTraj{1}.t);
RobRad = minDistRobCenter / 2;

OutTraj = RawTraj;
if nargin < 3
    RobIndices = 1:RobotCount;
end
if nargin < 4
    symmetry = 1;
end
frac1 = symmetry;
frac2 = 2 - frac1;

for rn1 = 1:length(RobIndices)
    robotNo1 = RobIndices(rn1);
    for rn2 = (rn1+1):length(RobIndices)
        robotNo2 = RobIndices(rn2);
        DrcxVec = RawTraj{robotNo2}.x - RawTraj{robotNo1}.x;
        DrcyVec = RawTraj{robotNo2}.y - RawTraj{robotNo1}.y;
        CenterDistVec = sqrt(DrcxVec.*DrcxVec + DrcyVec.*DrcyVec);
        CollideIndices = find(CenterDistVec < minDistRobCenter);
        for a = CollideIndices
            rcx1 = RawTraj{robotNo1}.x(a);
            rcy1 = RawTraj{robotNo1}.y(a);
            rcx2 = RawTraj{robotNo2}.x(a);
            rcy2 = RawTraj{robotNo2}.y(a);
            Drcx = DrcxVec(a);
            Drcy = DrcyVec(a);
            CenterDist = CenterDistVec(a);
            if (CenterDist > minDistRobCenter)
                OutTraj{robotNo1}.x(a) = rcx1;
                OutTraj{robotNo1}.y(a) = rcy1;
                OutTraj{robotNo2}.x(a) = rcx2;
                OutTraj{robotNo2}.y(a) = rcy2;
            elseif CenterDist > 0
                segmentXc = (rcx1+rcx2)/2;
                segmentYc = (rcy1+rcy2)/2;
                shiftRatio = RobRad/CenterDist;
                OutTraj{robotNo1}.x(a) = segmentXc - frac1*shiftRatio*Drcx;
                OutTraj{robotNo1}.y(a) = segmentYc - frac1*shiftRatio*Drcy;
                OutTraj{robotNo2}.x(a) = segmentXc + frac2*shiftRatio*Drcx;
                OutTraj{robotNo2}.y(a) = segmentYc + frac2*shiftRatio*Drcy;
            else
                MovVecMag = 0;
                k = 1;
                while (MovVecMag==0)
                    MovVecX = (RawTraj{robotNo1}.x(a+k)-RawTraj{robotNo1}.x(a-k)) + (RawTraj{robotNo2}.x(a+k)-RawTraj{robotNo2}.x(a-k));
                    MovVecY = (RawTraj{robotNo1}.y(a+k)-RawTraj{robotNo1}.y(a-k)) + (RawTraj{robotNo2}.y(a+k)-RawTraj{robotNo2}.y(a-k));
                    MovVecMag = sqrt(MovVecX*MovVecX + MovVecY*MovVecY);
                    k = k + 1;
                end
                SegVecX = MovVecY / MovVecMag;
                SegVecY = -MovVecX / MovVecMag;
                RefSegVecMag = 0;
                k = 1;
                while (RefSegVecMag==0)
                    RefSegVecX = (OutTraj{robotNo2}.x(a-k)-OutTraj{robotNo1}.x(a-k))/2;
                    RefSegVecY = (OutTraj{robotNo2}.y(a-k)-OutTraj{robotNo1}.y(a-k))/2;
                    RefSegVecMag = sqrt(RefSegVecX*RefSegVecX + RefSegVecY*RefSegVecY);
                    k = k + 1;
                end
                if (SegVecX*RefSegVecX + SegVecY*RefSegVecY) < 0
                    SegVecX = -SegVecX;
                    SegVecY = -SegVecY;
                end
                OutTraj{robotNo1}.x(a) = rcx1 - frac1*SegVecX*RobRad; % check!
                OutTraj{robotNo1}.y(a) = rcy1 - frac1*SegVecY*RobRad;
                OutTraj{robotNo2}.x(a) = rcx2 + frac2*SegVecX*RobRad;
                OutTraj{robotNo2}.y(a) = rcy2 + frac2*SegVecY*RobRad;
            end
        end
    end
end

% ------------------------------------------------------------------------

function [OutTraj, badAngleCount] = TrajPostProcess_EliminateSharpTurns(RawTraj, TurnThresh)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);

OutTraj = RawTraj;
badAngleCount = 0;

for robotNo = 1:RobotCount
    
    DXs = diff(RawTraj{robotNo}.x);
    DYs = diff(RawTraj{robotNo}.y);
    SegmentSlopeAng = atan2(DYs, DXs);
    LastSegmentSlopeAng = 0;
    for a = [1:length(SegmentSlopeAng), length(SegmentSlopeAng):-1:1]
        if (DXs(a)==0 && DYs(a)==0 && SegmentSlopeAng(a)==0)
            SegmentSlopeAng(a) = LastSegmentSlopeAng;
        else
            LastSegmentSlopeAng = SegmentSlopeAng(a);
        end
    end
    Turns = [0, diff(SegmentSlopeAng), 0];
    Turns = Turns + 2*pi*(Turns<=-pi) - 2*pi*(Turns>pi);
    badTurnIndices = (abs(Turns) > TurnThresh);
    badAngleCount = badAngleCount + sum(badTurnIndices);
    
    k = max([1, find(badAngleCount,1)-1]);
    ClusterStart = -1;
    while (k < length(badTurnIndices))
        if (ClusterStart==-1 && badTurnIndices(k)==0 && badTurnIndices(k+1)==1) % Start a new cluster
            ClusterStart = k+1;
        elseif (ClusterStart>0 && badTurnIndices(k)==1 && badTurnIndices(k+1)==0) % End a cluster
            OutTraj{robotNo}.x(ClusterStart:k) = interp1([(ClusterStart-1),(k+1)], OutTraj{robotNo}.x([(ClusterStart-1),(k+1)]), ClusterStart:k);
            OutTraj{robotNo}.y(ClusterStart:k) = interp1([(ClusterStart-1),(k+1)], OutTraj{robotNo}.y([(ClusterStart-1),(k+1)]), ClusterStart:k);
            ClusterStart = -1;
        end
        k = k + 1;
    end
    
end

% ------------------------------------------------------------------------

function OutTraj = TrajPostProcess_RemoveAllStatic(RawTraj)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle
RobotCount = length(IterData{IterNo}.Robot);

OutTraj = RawTraj;

StaticIndices = true(1, length(RawTraj{1}.t)-1);
for robotNo = 1:RobotCount
    DXs = diff(RawTraj{robotNo}.x);
    DYs = diff(RawTraj{robotNo}.y);
    DTHs = diff(RawTraj{robotNo}.th);
    StaticIndices = StaticIndices & (DXs==0 & DYs==0 & DTHs==0);
end
StaticIndices = StaticIndices(1:end+1-find(StaticIndices(end:-1:1)==0,1));
NonStaticIndicesNo = find(~StaticIndices);

for robotNo = 1:RobotCount
    OutTraj{robotNo}.x = OutTraj{robotNo}.x(NonStaticIndicesNo);
    OutTraj{robotNo}.y = OutTraj{robotNo}.y(NonStaticIndicesNo);
    OutTraj{robotNo}.th = OutTraj{robotNo}.th(NonStaticIndicesNo);
    OutTraj{robotNo}.t = OutTraj{robotNo}.t(NonStaticIndicesNo);
end

