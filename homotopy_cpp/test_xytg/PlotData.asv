function edit3_Callback(hObject, eventdata, handles)
% hObject    handle to edit3 (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hints: get(hObject,'String') returns contents of edit3 as text
%        str2double(get(hObject,'String')) returns contents of edit3 as a double

LoadFile(get(hObject,'String'));

% ====================================================================================

function LoadData(fileName)
global ObsCoords DynamicObsCoords ObsPolys IterData DistanceConstraints Params
global fid DataFileName

DataFileName = fileName;
fid = fopen(fileName, 'r');

% Read headers here

iterNo = 0;
FileEnd = 0;
ObsCoords = [];
DynamicObsCoords = {};
ObsPolys = {};
Params.Robot = {};
Params.Xscale = 1.0;
Params.Yscale = 1.0;
Params.Tscale = 1.0;

lineNo = 0;
SuperIterNo = 0;
DataType = '';
while (~FileEnd)

    thisLine = fgetl(fid);
    lineNo = lineNo + 1;
    try
        firstString = sscanf(thisLine, '%s', 1);
    catch
        disp(sprintf('WARNING: Error in reading line %d', lineNo));
        break;
    end

    switch(firstString)

        case 'ITERATION'
            iterNoInFile = sscanf(thisLine, '%*s %d', 2) + 1;
            iterNo = iterNo + 1;
            robotNo = 0;
            IterData{iterNo}.PenaltyWeights = [];
            IterData{iterNo}.SubIterNo = iterNoInFile;
            if iterNoInFile==1
                SuperIterNo = SuperIterNo + 1;
            end
            IterData{iterNo}.SuperIterNo = SuperIterNo;

        case 'ACTIVE_ROBOT'
            activeRobot = sscanf(thisLine, '%*s %d', 2) + 1;
            IterData{iterNo}.ActiveRobot = activeRobot;
            
        case 'CONSTRAINT'
            DataType = 'CONSTRAINT';
            thisConstraint = sscanf(thisLine, '%*s %f %f %f', 3);
            %IterData{iterNo}.PenaltyWeight(thisConstraint(1)+1) = thisConstraint(2);
            IterData{iterNo}.PenaltyWeights(end+1).Robot1 = thisConstraint(1)+1;
            IterData{iterNo}.PenaltyWeights(end).Robot2 = thisConstraint(2)+1;
            IterData{iterNo}.PenaltyWeights(end).Weight = thisConstraint(3);
            
        case 'CONSTRAINT_DEFINITION'
            DataType = 'CONSTRAINT_DEFINITION';
            thisConstraintDefinition = sscanf(thisLine, '%*s %d %d %d', 3);
            CONSTRAINT_DEFINITION_now = thisConstraintDefinition(1)+1;
            DistanceConstraints{CONSTRAINT_DEFINITION_now}.Robots = 1 + thisConstraintDefinition(2:3);
            DistanceConstraints{CONSTRAINT_DEFINITION_now}.Profile = [];
            
        case 'ROBOT'
            DataType = 'ROBOT';
            robotNo = sscanf(thisLine, '%*s %d', 2) + 1;
            IterData{iterNo}.Robot{robotNo}.Traj = [];
            
        case 'KEYPOINTS'
            DataType = 'KEYPOINTS';
            %robotNo = sscanf(thisLine, '%*s %d', 2) + 1;
            IterData{iterNo}.Robot{robotNo}.TrajKeyPts = [];
            
        case 'OBSTACLE'
            ObsTime = sscanf(thisLine, '%*s %d', 1);
            if isempty(ObsTime)
                DataType = 'OBSTACLE';
            else
                DataType = 'DYNAMIC_OBSTACLE';
                DynamicObsTime = ObsTime;
                DynamicObsCoords{DynamicObsTime+1} = [];
            end

        case 'END'
            FileEnd = 1;
            
        case 'ROBOT_TASK'
            thisRobotTask = sscanf(thisLine, '%*s %d %d %d', 3);
            if length(Params.Robot)<(thisRobotTask(1)+1) || ~isfield(Params.Robot{thisRobotTask(1)+1}, 'Tasks')
                Params.Robot{thisRobotTask(1)+1}.Tasks = [thisRobotTask(2), thisRobotTask(3)]';
            else
                Params.Robot{thisRobotTask(1)+1}.Tasks(:,end+1) = [thisRobotTask(2), thisRobotTask(3)]';
            end
        
        case 'SCALE_FACTOR'
            scaleFactors = sscanf(thisLine, '%*s %f %f %f', 3);
            Params.Xscale = scaleFactors(1);
            Params.Yscale = scaleFactors(2);
            Params.Zscale = scaleFactors(3);
            
        otherwise
            if true %~isempty(str2num(firstString))
                switch(DataType)
                    case 'ROBOT'
                        thisTrajPt = sscanf(thisLine, '%d %d %d', 3);
                        thisTimeIndex = thisTrajPt(3);
                        for emptyTimeIndex = (size(IterData{iterNo}.Robot{robotNo}.Traj,1)+1):thisTimeIndex
                            IterData{iterNo}.Robot{robotNo}.Traj(end+1,:) = [thisTrajPt(1:2)', emptyTimeIndex-1];
                        end
                        IterData{iterNo}.Robot{robotNo}.Traj(end+1,:) = thisTrajPt';
                    case 'KEYPOINTS'
                        thisTrajPt = sscanf(thisLine, '%d %d %d', 3);
                        thisTimeIndex = thisTrajPt(3);
                        lastTrajSize = size(IterData{iterNo}.Robot{robotNo}.TrajKeyPts,1);
                        if (lastTrajSize==0 || true)
                            IterData{iterNo}.Robot{robotNo}.TrajKeyPts(end+1,:) = [thisTrajPt(1:2)', 0];
                        else
                            lastTrajPt = IterData{iterNo}.Robot{robotNo}.TrajKeyPts(end,:)';
                            if (lastTrajPt(3) ~= thisTimeIndex)
                                for emptyTimeIndex = (lastTrajSize+1):thisTimeIndex
                                    lastfrac = (emptyTimeIndex - lastTrajSize) / (thisTimeIndex - lastTrajSize);
                                    IterData{iterNo}.Robot{robotNo}.TrajKeyPts(end+1,:) = [((1-lastfrac)*lastTrajPt(1:2)+lastfrac*thisTrajPt(1:2))', emptyTimeIndex-1];
                                end
                                IterData{iterNo}.Robot{robotNo}.TrajKeyPts(end+1,:) = thisTrajPt';
                            end
                        end
                    case 'OBSTACLE'
                        obstype = sscanf(thisLine, '%s', 1);
                        switch (obstype)
                            case 'Rectangle:'
                                corners = sscanf(thisLine, '%*s %f %f %f %f', 4);
                                thisPoly = [corners(1), corners(3), corners(3), corners(1) ; corners(2), corners(2), corners(4), corners(4)];
                                ObsPolys{end+1} = thisPoly;
                            case 'Circle:'
                                circ = sscanf(thisLine, '%*s %f %f %f', 3);
                                thisPoly = [];
                                for aa=pi/100:pi/100:2*pi
                                    thisPoly(:,end+1) = [circ(1);circ(2)] + circ(3)*[cos(aa);sin(aa)];
                                end
                                ObsPolys{end+1} = thisPoly;
                            otherwise
                                thisObsCoord = sscanf(thisLine, '%d %d', 2);
                                ObsCoords(end+1,:) = thisObsCoord';
                        end
                    case 'DYNAMIC_OBSTACLE'
                        thisDynamicObsCoord = sscanf(thisLine, '%d %d', 2);
                        DynamicObsCoords{DynamicObsTime+1}(end+1,:) = thisDynamicObsCoord';
                    case 'CONSTRAINT_DEFINITION'
                        thisConstraintPoint = sscanf(thisLine, '%d %d', 2);
                        DistanceConstraints{CONSTRAINT_DEFINITION_now}.Profile(end+1,:) = thisConstraintPoint';
                end
            else
                disp(sprintf('WARNING: Unknown flag "%s" skipped!', firstString));
            end

    end
    
end

global MaxTimeStep
MaxTimeStep = 0;
for iter = 1:length(IterData)
    for robot = 1:length(IterData{iter}.Robot)
        MaxTimeStep = max([MaxTimeStep length(IterData{iter}.Robot{robot}.Traj)]);
    end
end
%{
% Making all trajectories of equal length:
for iter = 1:length(IterData)
    for robot = 1:length(IterData{iter}.Robot)
        currentLength = size(IterData{iter}.Robot{robot}.Traj,1);
        if currentLength < MaxTimeStep
            IterData{iter}.Robot{robot}.Traj(currentLength+1:MaxTimeStep,1:2) = ...
                repmat(IterData{iter}.Robot{robot}.Traj(currentLength,1:2), [MaxTimeStep-currentLength, 1]);
            IterData{iter}.Robot{robot}.Traj(currentLength+1:MaxTimeStep,3) = (currentLength+1):MaxTimeStep;
        end
        currentLengthKey = size(IterData{iter}.Robot{robot}.TrajKeyPts,1);
        if currentLengthKey < MaxTimeStep
            IterData{iter}.Robot{robot}.TrajKeyPts(currentLengthKey+1:MaxTimeStep,1:2) = ...
                repmat(IterData{iter}.Robot{robot}.TrajKeyPts(currentLengthKey,1:2), [MaxTimeStep-currentLengthKey, 1]);
            IterData{iter}.Robot{robot}.TrajKeyPts(currentLengthKey+1:MaxTimeStep,3) = (currentLengthKey+1):MaxTimeStep;
        end
        %disp(size(IterData{iter}.Robot{robot}.Traj));
    end
end
%}

fclose(fid);

% ====================================================================================

function PlotThisFrame(DifferentFigHandle)
global ObsCoords DynamicObsCoords ObsPolys IterData Params
global IterNo TimeStepNo
global figHandle
global DynaJump
DynaJump = 10;

if nargin > 0
    figure(DifferentFigHandle);
else
    figure(figHandle);
end
axis equal;
%axis tight;
grid on;
set(gca, 'GridLineStyle', ':');
gridcolor = [0.9 0.9 0.8];
set(gca, 'XColor', gridcolor);
set(gca, 'YColor', gridcolor);
%{
axisTickPts = (-1000:10:1000)*(0.25/Params.Xscale);
set(gca, 'XTick', axisTickPts);
set(gca, 'XTickLabel', Params.Xscale*axisTickPts);
set(gca, 'YTick', axisTickPts);
set(gca, 'YTickLabel', Params.Yscale*axisTickPts);
%}
hold on;
cla;

axis([0 100 0 100]);

colorObstacle = [0.55 0.6 0.55]; % [1 0 0]

styles = {'-','-.','--'};
linewidths = {2.5, 2.5, 2.5};
FixedTrajColors = {[0.5 0 0], [0 0 0.5], [0 0.5 0]}; %, [0.5 0.5 0], [0.5 0 0.5], [0 0.5 0.5], [0 0 0]};

robColors = {[1 0 0], [0 0 1], [0 1 0]};

if size(ObsCoords,1) > 0
    plotCell(ObsCoords(:,1)', ObsCoords(:,2)', colorObstacle);
end
for a=1:length(ObsPolys)
    patch(ObsPolys{a}(1,:), ObsPolys{a}(2,:), colorObstacle);
end

legendPos = [90 95];
if length(DynamicObsCoords) > 0
    for a=DynaJump:DynaJump:length(DynamicObsCoords)
        thisCol = 0.9*[1 1 1] - (0.9*[1 1 1]-colorObstacle)*a/length(DynamicObsCoords);
        plotCell(DynamicObsCoords{a}(:,1)', DynamicObsCoords{a}(:,2)', thisCol);
        %text(mean(DynamicObsCoords{a}(:,1)), mean(DynamicObsCoords{a}(:,2)), sprintf('%d',a), 'Color', [0 0 0], 'FontSize', 8);
        plotCell((legendPos(1)-5):legendPos(1),ones(1,6)*legendPos(2)-a/DynaJump, thisCol);
        patch((legendPos(1)-5):legendPos(1),ones(1,6)*legendPos(2)-a/DynaJump, 
        if mod(a-DynaJump,3*DynaJump)==0
            text(legendPos(1)+1,legendPos(2)-a/DynaJump, sprintf('%d',a), 'Color', [0 0 0], 'FontSize', 8);
        end
    end
end

for robotNo = 1:length(IterData{IterNo}.Robot)
    styleNo = floor(robotNo/length(FixedTrajColors)) + 1;
    colNo = mod(robotNo,length(FixedTrajColors)) + 1;
    
    if isempty(IterData{IterNo}.Robot{robotNo}.Traj)
        continue;
    end
    
    try
        plotCell(Params.Robot{robotNo}.Tasks(1,:), Params.Robot{robotNo}.Tasks(2,:), robColors{robotNo}, 2);
    end
    
    if ((robotNo==IterData{IterNo}.ActiveRobot) & 0)
        plotCell(IterData{IterNo}.Robot{robotNo}.Traj(:,1)', IterData{IterNo}.Robot{robotNo}.Traj(:,2)', [0.1 0 0]);
    else
        %1: trajColor = [0, 0.3+0.7*robotNo/length(IterData{IterNo}.Robot)*mod(robotNo+1,2), 0.3+0.7*robotNo/length(IterData{IterNo}.Robot)*mod(robotNo,2)];
        % trajColor = (0.2 + 0.2*robotNo/length(IterData{IterNo}.Robot)*mod(robotNo,2)) * [1 1 1];
        trajColor = FixedTrajColors{colNo};
        startTrajColors = [1 1 1] - 0.5*([1 1 1]-trajColor);
        %~plotCell(IterData{IterNo}.Robot{robotNo}.Traj(:,1)', IterData{IterNo}.Robot{robotNo}.Traj(:,2)', trajColor, 3, styles{robotNo});
        if isfield(IterData{IterNo}.Robot{robotNo}, 'TrajKeyPts') && length(IterData{IterNo}.Robot{robotNo}.TrajKeyPts>0)
            plotCell(IterData{IterNo}.Robot{robotNo}.TrajKeyPts(:,1)', IterData{IterNo}.Robot{robotNo}.TrajKeyPts(:,2)', [startTrajColors; trajColor], 3, styles{styleNo}, linewidths{styleNo});
        else
            plotCell(IterData{IterNo}.Robot{robotNo}.Traj(:,1)', IterData{IterNo}.Robot{robotNo}.Traj(:,2)', [startTrajColors; trajColor], 3, styles{styleNo}, linewidths{styleNo});
        end
    end

    try
        %{
        if size(IterData{IterNo}.Robot{robotNo}.Traj,1) >= TimeStepNo
            thisTimeStepNo = TimeStepNo;
        else
            thisTimeStepNo = size(IterData{IterNo}.Robot{robotNo}.Traj,1);
        end
        %}
        thisTimeStepNo = TimeStepNo;
        %~plotCell(IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,1), IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,2), robColors{robotNo}, 1);
        %~text(IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,1)+1, IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,2)+1, num2str(robotNo));
        plotCell(IterData{IterNo}.Robot{robotNo}.TrajKeyPts(thisTimeStepNo,1), IterData{IterNo}.Robot{robotNo}.TrajKeyPts(thisTimeStepNo,2), robColors{robotNo}, 1);
        text(IterData{IterNo}.Robot{robotNo}.TrajKeyPts(thisTimeStepNo,1)+1, IterData{IterNo}.Robot{robotNo}.TrajKeyPts(thisTimeStepNo,2)+1, num2str(robotNo));
        %disp(['Robot' num2str(robotNo) ': (' num2str(IterData{IterNo}.Robot{robotNo}.Traj(TimeStepNo,1)) ',' num2str(IterData{IterNo}.Robot{robotNo}.Traj(TimeStepNo,2)) ')']);
    catch
        thisTimeStepNo = TimeStepNo;
        plotCell(IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,1), IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,2), robColors{mod(robotNo,length(robColors))+1}, 1);
        %text(IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,1)+1, IterData{IterNo}.Robot{robotNo}.Traj(thisTimeStepNo,2)+1, num2str(robotNo));
    end
    
end

% Custom plots
%plot([35 65], [50 50], 'bo');
%plot([0 0], [0 100], 'r-.', 'LineWidth', 10.0);

function plotCell(x,y,c,typ,styl,linewidth)
global DynaJump
patchX = [x-0.5; x+0.5; x+0.5; x-0.5];
patchY = [y+0.5; y+0.5; y-0.5; y-0.5];
if nargin < 4
    typ = 1;
end
switch(typ)
    case 1
        patch(patchX, patchY, c, 'EdgeColor', 'none');
    case 1.5
        patch(patchX, patchY, c, 'EdgeColor', [0 0 0]);
    case 2
        patch(patchX, patchY, 'w', 'EdgeColor', c);
    case 3
        if nargin < 5
            styl = '-';
        end
        if nargin < 6
            linewidth = 2.5;
        end
        if size(c,1)==1
            plot(x, y, styl, 'Color', c, 'LineWidth', linewidth);
        else
            for aa=1:size(patchX,2)
                lamb = (aa-1)/(size(patchX,2)-1);
                colorCC = lamb*c(2,:)+(1-lamb)*c(1,:);
                patch(patchX(:,aa), patchY(:,aa), colorCC, 'EdgeColor', 'none');
                if mod(aa,DynaJump)==0
                    text(mean(patchX(:,aa))+1, mean(patchY(:,aa)), sprintf('%d',aa), 'Color', colorCC, 'FontSize', 8);
                end
            end
        end
end

