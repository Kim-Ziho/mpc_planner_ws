function varargout = PlotData(varargin)
% PLOTDATA M-file for PlotData.fig
%      PLOTDATA, by itself, creates a new PLOTDATA or raises the existing
%      singleton*.
%
%      H = PLOTDATA returns the handle to a new PLOTDATA or the handle to
%      the existing singleton*.
%
%      PLOTDATA('CALLBACK',hObject,eventData,handles,...) calls the local
%      function named CALLBACK in PLOTDATA.M with the given input arguments.
%
%      PLOTDATA('Property','Value',...) creates a new PLOTDATA or raises the
%      existing singleton*.  Starting from the left, property value pairs are
%      applied to the GUI before PlotData_OpeningFunction gets called.  An
%      unrecognized property name or invalid value makes property application
%      stop.  All inputs are passed to PlotData_OpeningFcn via varargin.
%
%      *See GUI Options on GUIDE's Tools menu.  Choose "GUI allows only one
%      instance to run (singleton)".
%
% See also: GUIDE, GUIDATA, GUIHANDLES

% Copyright 2002-2003 The MathWorks, Inc.

% Edit the above text to modify the response to help PlotData

% Last Modified by GUIDE v2.5 05-Nov-2009 09:47:01

% Begin initialization code - DO NOT EDIT
gui_Singleton = 1;
gui_State = struct('gui_Name',       mfilename, ...
                   'gui_Singleton',  gui_Singleton, ...
                   'gui_OpeningFcn', @PlotData_OpeningFcn, ...
                   'gui_OutputFcn',  @PlotData_OutputFcn, ...
                   'gui_LayoutFcn',  [] , ...
                   'gui_Callback',   []);
if nargin && ischar(varargin{1})
    gui_State.gui_Callback = str2func(varargin{1});
end

if nargout
    [varargout{1:nargout}] = gui_mainfcn(gui_State, varargin{:});
else
    gui_mainfcn(gui_State, varargin{:});
end
% End initialization code - DO NOT EDIT


% --- Executes just before PlotData is made visible.
function PlotData_OpeningFcn(hObject, eventdata, handles, varargin)
% This function has no output args, see OutputFcn.
% hObject    handle to figure
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
% varargin   command line arguments to PlotData (see VARARGIN)

% Choose default command line output for PlotData
handles.output = hObject;

% Update handles structure
guidata(hObject, handles);

% UIWAIT makes PlotData wait for user response (see UIRESUME)
% uiwait(handles.figure1);

global figHandle slider1Handle edit1Handle slider2Handle edit2Handle edit3Handle listbox1Handle

figHandle = handles.figure1;
slider1Handle = handles.slider1;
edit1Handle = handles.edit1;
slider2Handle = handles.slider2;
edit2Handle = handles.edit2;
edit3Handle = handles.edit3;
listbox1Handle = handles.listbox1;

if(nargin > 0)
    LoadFile(varargin{1});
end

% =========================================================

function LoadFile(filename)

global figHandle slider1Handle edit1Handle slider2Handle edit2Handle edit3Handle listbox1Handle
global IterNo TimeStepNo
global ObsCoords IterData DistanceConstraints
global MaxTimeStep
global fid

%try
    clear global ObsCoords IterData
    disp('Please wait, loading data file...');
    LoadData(filename);
    global ObsCoords IterData DistanceConstraints
    disp('Data file loaded successfully!');
%{
catch
    fclose(fid);
    disp(lasterr);
    disp('ERROR in loading file!!');
    dbstack;
end
%}

%try
    
    global ObsCoords IterData DistanceConstraints
    
    set(slider1Handle, 'Min', 1);
    set(slider1Handle, 'Max', length(IterData));
    set(slider1Handle, 'SliderStep', [1 10]/length(IterData));
    set(slider2Handle, 'Min', 1);
    set(slider2Handle, 'Max', MaxTimeStep);
    set(slider2Handle, 'SliderStep', [1 10]/MaxTimeStep);
    set(edit3Handle, 'String', filename);

    IterNo = 1;
    TimeStepNo = 1;
    updateAll;
    
%{
catch
    
    global ObsCoords IterData DistanceConstraints
    
    if size(ObsCoords,1) > 0
        plotCell(ObsCoords(:,1)', ObsCoords(:,2)', [1 0 0]);
    end
    try
        fclose(fid);
    end
    disp(lasterr);
    disp('Incorrect data file!!');
    dbstack;
    
end
%}

% =========================================================

function updateAll()
global ObsCoords IterData DistanceConstraints
global figHandle slider1Handle edit1Handle slider2Handle edit2Handle edit3Handle listbox1Handle
global IterNo TimeStepNo

PlotThisFrame;
%pause(0.1);
set(slider1Handle,'Value', IterNo);
set(edit1Handle,'String',sprintf('%d [%d-%d]',IterNo,IterData{IterNo}.SuperIterNo,IterData{IterNo}.SubIterNo));
set(slider2Handle,'Value', TimeStepNo);
set(edit2Handle,'String',sprintf('%d',TimeStepNo));
ConstraintText = '';
for ConsNo=1:length(IterData{IterNo}.PenaltyWeights)
    %ConstraintText = [ConstraintText '\n' sprintf('%f',IterData{IterNo}.PenaltyWeight(ConsNo))];
    %ConstraintText{ConsNo} = sprintf('%d-%d :: %f',DistanceConstraints{ConsNo}.Robots(1),DistanceConstraints{ConsNo}.Robots(2), ...
    %                                    IterData{IterNo}.PenaltyWeight(ConsNo));
    ConstraintText{ConsNo} = sprintf('%d-%d :: %f',IterData{IterNo}.PenaltyWeights(ConsNo).Robot1,IterData{IterNo}.PenaltyWeights(ConsNo).Robot2, ...
                                        IterData{IterNo}.PenaltyWeights(ConsNo).Weight);
end
set(listbox1Handle,'String',ConstraintText);

% =========================================================

% --- Outputs from this function are returned to the command line.
function varargout = PlotData_OutputFcn(hObject, eventdata, handles) 
% varargout  cell array for returning output args (see VARARGOUT);
% hObject    handle to figure
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Get default command line output from handles structure
varargout{1} = handles.output;


