% --- Executes on button press in pushbutton2.
function pushbutton2_Callback(hObject, eventdata, handles)
% hObject    handle to pushbutton2 (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
%{
global IterNo
AvailableScarabNumbers = [1 2 3 4 5];

for robotNo = 1:length(IterData{IterNo}.Robot)
    RobotName{robotNo} = sprintf('scarab-%i', AvailableScarabNumbers(robotNo));
    Robot_Communicate('initiate', robotNo, {RobotName{robotNo},'laser','truth'});
end

for timeStepNo = 2:1:length(IterData{IterNo}.Robot{1}.Traj)
    HasReachedTarget = false(1, length(length(IterData{IterNo}.Robot)));
    while (~all(HasReachedTarget))
        for robotNo = 1:length(IterData{IterNo}.Robot)
            pTarget = IterData{iterNo}.Robot{robotNo}.Traj(timeStepNo,:);
            posdata = Robot_Communicate('getData_Pose', robotNo);
            posNow = world2sim(posdata);
            if norm(posNow-pTarget) < 0.06
                HasReachedTarget(robotNo
            end
            vel = ComputeVelocity_DiscretizedPath(IterData{iterNo}.Robot{robotNo}.Traj', posNow, timeStepNo-1, timeStepNo);
            Robot_Communicate('setVelocity', robotNo, vel);
        end
        pause(0.01);
    end
end
%}


% --- Executes on button press in pushbutton3.
function pushbutton3_Callback(hObject, eventdata, handles)
% hObject    handle to pushbutton3 (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
global ObsCoords IterData
global IterNo TimeStepNo
global MaxTimeStep
global figHandle DataFileName
RobotCount = length(IterData{IterNo}.Robot);

try
    for robotNo = 1:RobotCount
        %^RawTraj{robotNo} = IterData{IterNo}.Robot{robotNo}.TrajKeyPts; %IterData{IterNo}.Robot{robotNo}.Traj;
        RawTraj{robotNo}.x = IterData{IterNo}.Robot{robotNo}.TrajKeyPts(:,1);
        RawTraj{robotNo}.y = IterData{IterNo}.Robot{robotNo}.TrajKeyPts(:,2);
        RawTraj{robotNo}.t = IterData{IterNo}.Robot{robotNo}.TrajKeyPts(:,3);
    end
catch
    for robotNo = 1:RobotCount
        %^RawTraj{robotNo} = IterData{IterNo}.Robot{robotNo}.TrajKeyPts; %IterData{IterNo}.Robot{robotNo}.Traj;
        RawTraj{robotNo}.x = IterData{IterNo}.Robot{robotNo}.Traj(:,1);
        RawTraj{robotNo}.y = IterData{IterNo}.Robot{robotNo}.Traj(:,2);
        RawTraj{robotNo}.t = IterData{IterNo}.Robot{robotNo}.Traj(:,3);
    end
end

BadTurnAngles = [3*pi/4, pi/2, pi/4, pi/8];
BadTurnCorrectAttempts = 10;

for a=1:2
    disp(sprintf('Running pass %d...', a));
    RawTraj = TrajPostProcess_Interp(RawTraj, 1/2, 'cubic');
    RawTraj = TrajPostProcess_ObsAvoid(RawTraj, 0.6);
    RawTraj = TrajPostProcess_RobAvoid(RawTraj, 1.2, [1 2]);
    %%RawTraj = TrajPostProcess_EliminateSharpTurns(RawTraj, BadTurnAngles(a));
    badAngleCount = inf;
    itCount = 0;
    while (badAngleCount > 0 && itCount < BadTurnCorrectAttempts)
        [RawTraj, badAngleCount] = TrajPostProcess_EliminateSharpTurns(RawTraj, BadTurnAngles(a));
        disp(sprintf('Bad angle count = %d...', badAngleCount));
        itCount = itCount + 1;
    end
end
for a=3:4
    disp(sprintf('Running pass %d...', a));
    RawTraj = TrajPostProcess_Interp(RawTraj, 1/2, 'cubic');
    RawTraj = TrajPostProcess_ObsAvoid(RawTraj, 0.6);
    RawTraj = TrajPostProcess_RobAvoid(RawTraj, 1.2, [2 1]);
    %%RawTraj = TrajPostProcess_EliminateSharpTurns(RawTraj, BadTurnAngles(a));
    badAngleCount = inf;
    itCount = 0;
    while (badAngleCount > 0 && itCount < BadTurnCorrectAttempts)
        [RawTraj, badAngleCount] = TrajPostProcess_EliminateSharpTurns(RawTraj, BadTurnAngles(a));
        disp(sprintf('Bad angle count = %d...', badAngleCount));
        itCount = itCount + 1;
    end
end

%RawTraj = TrajPostProcess_ResampleUniformTime(RawTraj);

RawTraj = TrajPostProcess_ResampleUniformTime(RawTraj);
RawTraj = TrajPostProcess_LimitSpeed(RawTraj, 1.0);
RawTraj = TrajPostProcess_ComputeTheta(RawTraj);
RawTraj = TrajPostProcess_LimitTurnrate(RawTraj, 2*pi/3, [1 2]); % 2*pi/6

badAngleCount = inf;
itCount = 0;
while (badAngleCount > 0 && itCount < BadTurnCorrectAttempts)
    [RawTraj, badAngleCount] = TrajPostProcess_EliminateSharpTurns(RawTraj, BadTurnAngles(end));
    disp(sprintf('Recheck: Bad angle count = %d...', badAngleCount));
    itCount = itCount + 1;
end

RawTraj = TrajPostProcess_ComputeTheta(RawTraj);
RawTraj = TrajPostProcess_RemoveAllStatic(RawTraj);

badAngleCount = 0;
for robotNo = 1:RobotCount
    Turns = [diff(RawTraj{robotNo}.th)];
    Turns = Turns + 2*pi*(Turns<=-pi) - 2*pi*(Turns>pi);
    badTurnIndices{robotNo} = (abs(Turns) > BadTurnAngles(end));
    badAngleCount = badAngleCount + sum(badTurnIndices{robotNo});
end
if (badAngleCount>0)
    disp(sprintf('WARING: Final bad angle count = %d...', badAngleCount));
end

%figure(figHandle);
newFig = figure;
PlotThisFrame(newFig);
axis equal;
hold on;
for a = 1:length(RawTraj{1}.t)
    timeTxt{a} = sprintf('%d',RawTraj{1}.t(a));
end
for robotNo = 1:RobotCount
    %{
    for a=1:200
        plot(RawTraj{robotNo}.x(a:200:end), RawTraj{robotNo}.y(a:200:end), '.', 'Color', [a/200, 0, 0]);
        plot([RawTraj{robotNo}.x(a:200:end);RawTraj{robotNo}.x(a:200:end)+0.01*cos(RawTraj{robotNo}.th(a:200:end))], [RawTraj{robotNo}.y(a:200:end);RawTraj{robotNo}.y(a:200:end)+0.01*sin(RawTraj{robotNo}.th(a:200:end))],'g-')
    end
    %}
    plot(RawTraj{robotNo}.x, RawTraj{robotNo}.y, 'r.-');
    plot(RawTraj{robotNo}.x(badTurnIndices{robotNo}), RawTraj{robotNo}.y(badTurnIndices{robotNo}), 'bo');
    %text(RawTraj{robotNo}.x, RawTraj{robotNo}.y, timeTxt);
end

xScale = 0.35;
yScale = 0.35;
xOffset = 0; %17;
yOffset = 0; %5;
for robotNo = 1:RobotCount
    RawTraj{robotNo}.x = (RawTraj{robotNo}.x+0.5)*xScale - xOffset;
    RawTraj{robotNo}.y = (RawTraj{robotNo}.y+0.5)*yScale - yOffset;
end
disp('Writing trajectories to file...');
TrajFileName = sprintf('%s.traj', DataFileName);
fidTraj = fopen(TrajFileName,'w');
for tt = 1:length(RawTraj{1}.t)
    fprintf(fidTraj, '%f, ', RawTraj{1}.t(tt));
    for robotNo = 1:RobotCount
        fprintf(fidTraj, '%f, ', RawTraj{robotNo}.x(tt));
        fprintf(fidTraj, '%f, ', RawTraj{robotNo}.y(tt));
        fprintf(fidTraj, '%f, ', RawTraj{robotNo}.th(tt));
    end
    fprintf(fidTraj, '\n');
end
fclose(fidTraj);
disp('...done!!');


